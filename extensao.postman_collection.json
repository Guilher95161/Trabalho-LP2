    {
      "name": "Solicitacoes de Aproveitamento",
      "description": "Maquina de estados: PENDENTE → DEFERIDA | INDEFERIDA | CANCELADA (reenvio INDEFERIDA → PENDENTE em ate 5 dias).\nSeed: id=1 DEFERIDA, id=2 PENDENTE (Bruno/Seminario), id=3 DELEGADA (Bruno/Python), id=4 INDEFERIDA com prazo estourado (Ana/BD).",
      "item": [
        {
          "name": "Criar solicitacao",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/api/solicitacoes", "host": ["{{base}}"], "path": ["api","solicitacoes"] },
            "body": { "mode": "raw", "raw": "{\n  \"solicitanteId\": 5,\n  \"certificadoId\": 1\n}" }
          }
        },
        {
          "name": "Buscar por status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/solicitacoes/obter?status=PENDENTE",
              "host": ["{{base}}"], "path": ["api","solicitacoes","obter"],
              "query": [{ "key": "status", "value": "PENDENTE" }]

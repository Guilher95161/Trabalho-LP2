    {
      "name": "Oportunidades",
      "description": "Maquina de estados: RASCUNHO → AGUARDANDO_APROVACAO → ABERTA → EM_EXECUCAO → ENCERRADA (ou CANCELADA).\nSeed: id=3 ABERTA (Workshop Algoritmos), id=2 EM_EXECUCAO (Git).\nModalidades: CURSO, EVENTO, PROJETO, PROGRAMA, PRESTACAO_DE_SERVICOS, PRODUTO.",
      "item": [
        {
          "name": "Criar oportunidade [DOCENTE/COORD/ADMIN]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/api/oportunidades", "host": ["{{base}}"], "path": ["api","oportunidades"] },
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Curso de Spring Boot\",\n  \"descricao\": \"Desenvolvimento de APIs REST com Spring Boot.\",\n  \"modalidade\": \"CURSO\",\n  \"periodoRealizacao\": \"01/08/2026 - 31/08/2026\",\n  \"cargaHoraria\": 40,\n  \"vagas\": 20,\n  \"status\": \"RASCUNHO\"\n}" }
          }
        },
        {
          "name": "Buscar por titulo ou status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/oportunidades/obter?titulo=Java",
              "host": ["{{base}}"], "path": ["api","oportunidades","obter"],
              "query": [
                { "key": "titulo", "value": "Java" },
                { "key": "status", "value": "ABERTA", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base}}/api/oportunidades/3", "host": ["{{base}}"], "path": ["api","oportunidades","3"] }
          }
        },
        {
          "name": "Atualizar [DOCENTE/COORD]",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/api/oportunidades/8", "host": ["{{base}}"], "path": ["api","oportunidades","8"] },
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Curso de Spring Boot Avancado\",\n  \"modalidade\": \"CURSO\",\n  \"cargaHoraria\": 60,\n  \"vagas\": 15,\n  \"status\": \"RASCUNHO\"\n}" }
          }
        },
        {
          "name": "Remover [ADMIN]",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base}}/api/oportunidades/8", "host": ["{{base}}"], "path": ["api","oportunidades","8"] }
          }
        },
        {
          "name": "— Maquina de estados —",
          "item": [
            {
              "name": "Submeter (RASCUNHO → AGUARDANDO) [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base}}/api/oportunidades/8/submeter", "host": ["{{base}}"], "path": ["api","oportunidades","8","submeter"] }
              }
            },
            {
              "name": "Aprovar (AGUARDANDO → ABERTA) [COORD]",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base}}/api/oportunidades/8/aprovar", "host": ["{{base}}"], "path": ["api","oportunidades","8","aprovar"] }
              }
            },
            {
              "name": "Iniciar (ABERTA → EM_EXECUCAO) [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base}}/api/oportunidades/3/iniciar", "host": ["{{base}}"], "path": ["api","oportunidades","3","iniciar"] }
              }
            },
            {
              "name": "Encerrar (EM_EXECUCAO → ENCERRADA) [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base}}/api/oportunidades/2/encerrar", "host": ["{{base}}"], "path": ["api","oportunidades","2","encerrar"] }
              }
            },
            {
              "name": "Cancelar (qualquer estado) [DOCENTE/COORD/ADMIN]",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base}}/api/oportunidades/8/cancelar?motivo=Falta%20de%20recursos",
                  "host": ["{{base}}"], "path": ["api","oportunidades","8","cancelar"],
                  "query": [{ "key": "motivo", "value": "Falta de recursos" }]
                }
              }
            }
          ]
        },
        {
          "name": "— Inscricoes —",
          "item": [
            {
              "name": "Inscrever discente (coloca na fila FIFO)",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base}}/api/oportunidades/3/inscrever?discenteId=6",
                  "host": ["{{base}}"], "path": ["api","oportunidades","3","inscrever"],
                  "query": [{ "key": "discenteId", "value": "6" }]
                }
              }
            },
            {
              "name": "Avaliar inscricao (aprovar/reprovar) [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base}}/api/oportunidades/3/avaliar-inscricao?discenteId=6&aprovar=true",
                  "host": ["{{base}}"], "path": ["api","oportunidades","3","avaliar-inscricao"],
                  "query": [
                    { "key": "discenteId", "value": "6" },
                    { "key": "aprovar",    "value": "true" }
                  ]
                }
              }
            },
            {
              "name": "Cancelar inscricao",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base}}/api/oportunidades/3/cancelar-inscricao?discenteId=6",
                  "host": ["{{base}}"], "path": ["api","oportunidades","3","cancelar-inscricao"],
                  "query": [{ "key": "discenteId", "value": "6" }]
                }
              }
            },
            {
              "name": "Substituir participante [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base}}/api/oportunidades/3/substituir?aRemoverId=5&substitutoId=6",
                  "host": ["{{base}}"], "path": ["api","oportunidades","3","substituir"],
                  "query": [
                    { "key": "aRemoverId",  "value": "5" },
                    { "key": "substitutoId","value": "6" }
                  ]
                }
              }
            },
            {
              "name": "Certificar participantes (gera Certificado) [DOCENTE/COORD]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{base}}/api/oportunidades/2/certificar", "host": ["{{base}}"], "path": ["api","oportunidades","2","certificar"] },
                "body": { "mode": "raw", "raw": "[5, 6]" }
              }
            }
          ]
        }
      ]
    },

